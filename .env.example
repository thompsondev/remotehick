# Database
# Coolify: set DATABASE_URL as a build-time AND runtime env var (needed for prisma migrate during build).
DATABASE_URL="postgresql://user:password@localhost:5432/aios"

# AI (required for /v1/chat/prompt)
AI_GATEWAY_API_KEY="your-gateway-api-key"
# Model identifier (optional; default: openai/gpt-4o-mini)
AI_MODEL="openai/gpt-4o-mini"

# Valyu web search (optional; get free key at https://platform.valyu.ai)
# VALYU_API_KEY="your-valyu-api-key"

# Server
# Coolify sets PORT automatically — do not hardcode in production.
# PORT=3000
# Optional; if set, all routes require x-api-key header matching this value
# API_KEY="your-secret-api-key"

# When API_KEY is not set: only requests whose Host matches a domain listed in DOMAIN_CHAT are limited per day per IP; all other domains are unlimited. DOMAIN_CHAT can be one or more hostnames, comma-separated (e.g. chat.example.com or chat.a.com,chat.b.com). Limit per listed domain: default 5, or PROMPTS_PER_DAY_CHAT. Omit DOMAIN_CHAT for unlimited prompts everywhere.
# DOMAIN_CHAT="chat.example.com"
# DOMAIN_CHAT="chat.a.com,chat.b.com"
# PROMPTS_PER_DAY_CHAT=5

# Swagger / docs (optional). PLATFORM_URL also controls branding: copyright is shown only when request host matches this URL's host or is a subdomain.
PLATFORM_NAME="AIOS"
PLATFORM_URL="https://dev.digitalcoresystem.com"
DEVELOPMENT_URL="dev.digitalcoresystem.com"
PRODUCTION_URL="dev.digitalcoresystem.com"

# CORS — comma-separated origins (no trailing slash). Also auto-added from
# ENROLLMENT_LINK_BASE_URL and PLATFORM_URL if set.
CORS_ORIGINS="https://front.digitalcoresystem.com"

# Branding shown in the demo UI header ("by X") and footer; always shown on localhost, and on PLATFORM_URL or its subdomains; otherwise hidden (optional)
# AUTHOR_NAME="your-name"
# AUTHOR_URL="https://your-website.com"

# Slack (optional; required for Slack bot integration)
# Bot token from your Slack app's OAuth & Permissions page (starts with xoxb-)
# SLACK_BOT_TOKEN="xoxb-your-bot-token"
# Signing secret from your Slack app's Basic Information page — used to verify requests from Slack
# SLACK_SIGNING_SECRET="your-signing-secret"

# WhatsApp Cloud API (optional; required for WhatsApp bot integration)
# WHATSAPP_CLOUD_API_VERSION="v17.0"
# WHATSAPP_CLOUD_API_PHONE_NUMBER_ID="your-phone-number-id"
# WHATSAPP_CLOUD_API_ACCESS_TOKEN="your-access-token"
# Token you set in the Meta webhook config to verify the subscription challenge
# WHATSAPP_CLOUD_API_WEBHOOK_VERIFICATION_TOKEN="your-webhook-verify-token"

# Remote access MVP
JWT_SECRET="change-me-in-production"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="admin123"

# Email notifications (Resend or ZeptoMail)
# Provider: "resend" (default) or "zeptomail"
# EMAIL_PROVIDER="resend"
# Sender address — use "Name <email@domain.com>" or just the email
# EMAIL_FROM="Remote Access <notifications@yourdomain.com>"
# Comma-separated list of addresses that receive all alerts
# NOTIFICATION_EMAIL="admin@example.com,ops@example.com"
# Set to "false" to disable all notification emails
# NOTIFICATION_ENABLED="true"
#
# Resend — https://resend.com/api-keys
# RESEND_API_KEY="re_xxxxxxxx"
#
# ZeptoMail — https://www.zoho.com/zeptomail/help/api/email-sending.html
# ZEPTOMAIL_API_KEY="Zoho-enczapikey xxxxxxxx"
ENROLLMENT_LINK_BASE_URL="https://front.digitalcoresystem.com/enroll"
ENROLLMENT_INSTANT_BASE_URL="https://front.digitalcoresystem.com/connect"
# Bundled into agent zip by pnpm copy:agent (defaults from PLATFORM_URL)
# AGENT_API_URL="https://dev.digitalcoresystem.com/v1"
# AGENT_WS_URL="https://dev.digitalcoresystem.com"
# Agent download via Cloudinary (recommended for production)
# Get credentials from https://console.cloudinary.com/settings/api-keys
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"
# Set after running: pnpm upload:agent (multipart upload for Free plan)
# CLOUDINARY_AGENT_PARTS="https://res.cloudinary.com/.../part-01|https://res.cloudinary.com/.../part-02"
# CLOUDINARY_AGENT_PUBLIC_ID="remote-agent/Remote-Agent-win"
# Single-file upload (Plus plan or files under 10 MB):
# CLOUDINARY_AGENT_URL="https://res.cloudinary.com/.../Remote-Agent-win.zip"
#
# Google service account (also used for Sheets; required for Drive fallback upload)
# GOOGLE_CLIENT_EMAIL="service-account@project.iam.gserviceaccount.com"
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Optional Drive folder ID for agent uploads
# GOOGLE_DRIVE_AGENT_FOLDER_ID=""
# Set after running: pnpm upload:agent:drive
# GOOGLE_DRIVE_AGENT_FILE_ID=""
# AGENT_DOWNLOAD_URL="https://drive.google.com/uc?export=download&id=..."
#
# Dev fallback (local file, gitignored):
#   cd ../remoteagent && pnpm dist && cd ../remotehick && pnpm copy:agent
# AGENT_INSTALLER_PATH="public/agents/Remote-Agent-win.zip"
# 0 = links never expire (default). Set e.g. 24 for 24-hour expiry.
ENROLLMENT_LINK_TTL_HOURS=0
REDIS_URL="redis://localhost:6379"
# TURN_URL=
# TURN_USERNAME=
# TURN_CREDENTIAL=
