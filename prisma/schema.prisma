generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum DeviceStatus {
  ONLINE
  OFFLINE
}

enum DeviceType {
  NATIVE
  BROWSER
}

enum EnrollmentLinkKind {
  AGENT
  INSTANT
  BOTH
}

enum SessionStatus {
  PENDING
  ACTIVE
  ENDED
}

enum EnrollmentLinkEventType {
  OPEN
  DOWNLOAD
  CONNECT
}

model Admin {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         String   @default("admin")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  enrollmentLinks EnrollmentLink[]
  sessions        RemoteSession[]
}

model Device {
  id               String       @id @default(cuid())
  name             String
  os               String
  hostname         String
  ipAddress        String?
  browser          String?
  userAgent        String?
  timezone         String?
  language         String?
  country          String?
  city             String?
  screenResolution String?
  deviceType       DeviceType   @default(NATIVE)
  status           DeviceStatus @default(OFFLINE)
  deviceTokenHash  String
  enrolledAt       DateTime     @default(now())
  lastSeenAt       DateTime?
  revokedAt        DateTime?
  enrollmentLinkId String?

  enrollmentLink EnrollmentLink? @relation(fields: [enrollmentLinkId], references: [id], onDelete: SetNull)
  sessions       RemoteSession[]

  @@index([enrollmentLinkId])
}

model EnrollmentLink {
  id               String             @id @default(cuid())
  code             String             @unique
  kind             EnrollmentLinkKind @default(BOTH)
  expiresAt        DateTime?
  createdAt        DateTime           @default(now())
  createdByAdminId String

  createdByAdmin Admin                 @relation(fields: [createdByAdminId], references: [id])
  devices        Device[]
  events         EnrollmentLinkEvent[]
}

model EnrollmentLinkEvent {
  id         String                  @id @default(cuid())
  linkId     String
  type       EnrollmentLinkEventType
  visitorKey String?
  createdAt  DateTime                @default(now())

  link EnrollmentLink @relation(fields: [linkId], references: [id], onDelete: Cascade)

  @@index([linkId, type])
  @@index([linkId, createdAt])
}

model RemoteSession {
  id        String        @id @default(cuid())
  deviceId  String
  adminId   String
  status    SessionStatus @default(PENDING)
  startedAt DateTime?
  endedAt   DateTime?
  createdAt DateTime      @default(now())

  device Device @relation(fields: [deviceId], references: [id])
  admin  Admin  @relation(fields: [adminId], references: [id])

  @@index([deviceId])
  @@index([adminId])
}

model ChatMessage {
  id          String   @id @default(cuid())
  phoneNumber String
  role        String
  content     String
  createdAt   DateTime @default(now())

  @@index([phoneNumber])
}
