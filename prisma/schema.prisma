generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum DeviceStatus {
  ONLINE
  OFFLINE
}

enum SessionStatus {
  PENDING
  ACTIVE
  ENDED
}

enum EnrollmentLinkEventType {
  OPEN
  DOWNLOAD
}

model Admin {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         String   @default("admin")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  enrollmentLinks EnrollmentLink[]
  sessions        RemoteSession[]
}

model Device {
  id              String       @id @default(cuid())
  name            String
  os              String
  hostname        String
  ipAddress       String?
  status          DeviceStatus @default(OFFLINE)
  deviceTokenHash String
  enrolledAt      DateTime     @default(now())
  lastSeenAt      DateTime?
  revokedAt       DateTime?

  enrollmentLink EnrollmentLink?
  sessions       RemoteSession[]
}

model EnrollmentLink {
  id               String    @id @default(cuid())
  code             String    @unique
  expiresAt        DateTime
  usedAt           DateTime?
  createdAt        DateTime  @default(now())
  createdByAdminId String
  deviceId         String?   @unique

  createdByAdmin Admin   @relation(fields: [createdByAdminId], references: [id])
  device         Device? @relation(fields: [deviceId], references: [id])
  events         EnrollmentLinkEvent[]
}

model EnrollmentLinkEvent {
  id         String                  @id @default(cuid())
  linkId     String
  type       EnrollmentLinkEventType
  visitorKey String?
  createdAt  DateTime                @default(now())

  link EnrollmentLink @relation(fields: [linkId], references: [id], onDelete: Cascade)

  @@index([linkId, type])
  @@index([linkId, createdAt])
}

model RemoteSession {
  id        String        @id @default(cuid())
  deviceId  String
  adminId   String
  status    SessionStatus @default(PENDING)
  startedAt DateTime?
  endedAt   DateTime?
  createdAt DateTime      @default(now())

  device Device @relation(fields: [deviceId], references: [id])
  admin  Admin  @relation(fields: [adminId], references: [id])

  @@index([deviceId])
  @@index([adminId])
}

model ChatMessage {
  id          String   @id @default(cuid())
  phoneNumber String
  role        String
  content     String
  createdAt   DateTime @default(now())

  @@index([phoneNumber])
}
